# conf.dat

# ===================================================================
# Rung 4 of the v2 ladder, seed 779 (noise floor + rung-7 ensemble member): rung 3 + one random rotation about z per training sample (D-7); rung 3 = rung 2 + log_softmax head, log10 fraction targets and Ca II-relevance-weighted MSE (D-5, D-6);
# rung 2 inputs (plan D-4): global log10 standardization of
# T, rho, n_e, P, v/(10 km/s), no B, no raw height feature, edges (dz, d_h, |dr|) in Mm
# This file is the single source of truth for all parameters.
# ===================================================================

[system]
gpu = 0
seed = 779
# fraction of the GPU memory the training may use (shared GPU); comment out for an exclusive GPU
gpu_memory_fraction = 0.55

[data]
datadir = '../data_train_v2'
grid_file = '../en024048_hion/grid_bifrost.npz'
nx = 504
ny = 504
# Original nz after slicing (476 - 52 + 1)
nz_orig = 425
nlev = 6
# input quantities (file map in gnn_train.py); B dropped (D-4)
features = 'vel', 'temp', 'n_e', 'rho', 'press'

[dataset]
# Z-axis interpolation settings
nz_linear = 30
nz_log = 20
logspace_fraction = 0.33
# interpolate scalars and populations in log10 to the training grid (WP4.3; the old runs interpolated linearly)
interp_log = True
# vertical grid of the training run ('index' = 30 native indices linearly spaced over the first logspace_fraction of the cube + 20 log-spaced)
grid = 'index'
# Graph construction settings: edges within radius_neighbors * (xs + ys) / 3 in index units (level, pixel, pixel), star topology
radius_neighbors = 6.01
x_range_graph = 4
y_range_graph = 4
max_stride = 4
random_stride = True
# rung 4 (D-7): (vx, vy) and the stencil rotated by 0/90/180/270 deg about z, one draw per training sample; nothing else
augment_rotation = True
# Data split for train/test
train_ratio = 0.7

[training]
lr = 1e-3
batch_size = 8
epoch_size_fraction = 0.2
n_epochs = 15
savedir = 'checkpoints/v2_rung4_rotation_seed779/'
load_checkpoint = False
# Smoothed loss factor
smooth = 0.01
# D-2 validation: held-out corner at the training stride, outside this guard band (px); fraction of it to use
valid_guard = 32
valid_subset = 1.0
num_workers = 8
# rung-1 recipe (D-8): AdamW with decoupled weight decay on the weight matrices, linear warmup (1 epoch) + cosine to zero
# stepped per batch, gradient clipping, EMA of the weights (ramped), fresh random training subset every epoch
optimizer = 'adamw'
weight_decay = 0.01
adam_betas = 0.9, 0.95
adam_eps = 1e-6
schedule = 'warmup_cosine'
warmup_epochs = 1
grad_clip = 1.0
ema_decay = 0.9998
fresh_subset = True
relevance_threshold = 1e-2
coronal_weight = 0.1
# Scheduler milestones for learning rate reduction
milestones = 15, 30, 60, 120
# Scheduler reduction factor
gamma = 0.5

[model]
# Input size is 7 physical features (vx, vy, vz, log T, log n_e, log rho, log P), no z-position feature
node_input_size = 7
edge_input_size = 3
global_input_size = 1
latent_size = 128
mlp_hidden_size = 64
mlp_n_hidden_layers = 3
dropout=0.25
n_message_passing_steps = 8
# Output size is 6 CaII levels
output_size = 6
# rung 3 (D-5): outputs = log10(softmax + log_offset), fractions sum exactly to one
head = 'log_softmax'
head_log_offset = 1e-12

[normalization]
# targets log10(f + log_offset); inputs: global log10 standardization (normalization.py)
log_offset = 1e-12