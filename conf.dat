# conf.dat

# ===================================================================
# Master Configuration for GNN Training and Inference
# This file is the single source of truth for all parameters.
#   python gnn_train.py [conf.dat] [seed]      ->  <savedir>_seed<seed>/
# ===================================================================

[system]
gpu = 0
seed = 777
# fraction of the GPU memory the training may use (shared GPU; the training graphs vary in size)
gpu_memory_fraction = 1.0

[data]
datadir = '../data_train_v2'
grid_file = '../en024048_hion/grid_bifrost.npz'
nx = 504
ny = 504
# Original nz after slicing (476 - 52 + 1)
nz_orig = 425
nlev = 6
# horizontal pixel size [Mm]: 24 Mm / 504 columns (FITS CDELT1)
pixel_Mm = 0.047619

[dataset]
# Validation grid (= the deployment grid): 'dense:60' = 60 km steps from the bottom level to 4.5 Mm + 7 coronal levels
# (vertical_grids.fixed_grid). The training samples draw random two-zone grids (vertical_grids.random_grid)
grid = 'dense:125'
# Graph construction: the columns of the (2 x_range_graph + 1) x (2 y_range_graph + 1) stencil within stencil_radius
# (stencil units), hops of max_stride pixels (1..max_stride drawn per axis in training). Star edges: a node and a node
# of the central column are linked when their distance |dr| is <= edge_radius_Mm (two central nodes: when their heights
# differ by <= central_reach_Mm, or adjacent levels); the neighbour columns are not linked to each other
x_range_graph = 4
y_range_graph = 4
max_stride = 5
stencil_radius = 4.01
edge_radius_Mm = 1.01
central_reach_Mm = 1.51
# Data split for train/test
train_ratio = 0.7

[training]
lr = 1e-3
batch_size = 8
# fraction of the training columns drawn (afresh) every epoch
epoch_size_fraction = 0.15
n_epochs = 100
savedir = 'checkpoints/v3_lte'
# Smoothed loss factor
smooth = 0.01
# held-out columns at least valid_guard pixels from the training region are validated
valid_guard = 32
# AdamW (weight decay on the weight matrices), linear warmup over warmup_epochs then cosine decay (per batch),
# gradient clipping, exponential moving average of the weights (validated next to the raw weights)
weight_decay = 0.01
warmup_epochs = 1
grad_clip = 1.0
ema_decay = 0.9998
# loss weights: nodes with a Ca II fraction below relevance_threshold weigh less, never less than coronal_weight
relevance_threshold = 1e-2
coronal_weight = 0.1

[model]
# Input size: vx, vy, vz, log T, log rho, log P and the six log10 LTE fractions of the Ca levels
node_input_size = 12
# Edge features: dz, horizontal distance and |dr| [Mm]
edge_input_size = 3
global_input_size = 1
latent_size = 128
mlp_hidden_size = 64
mlp_n_hidden_layers = 3
dropout=0.2
n_message_passing_steps = 8
# Output size is 6 CaII levels
output_size = 6
# outputs = log10(softmax + head_log_offset): the log10 fractions (equal to [normalization] log_offset)
head_log_offset = 1e-12

[normalization]
# targets = log10(fractions + log_offset)
log_offset = 1e-12