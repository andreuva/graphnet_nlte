# conf.dat: the 3D Ca II GraphNet (the deployed model; its three-seed ensemble is the recommended configuration)
#
# python gnn_train.py conf.dat [seed]          -> checkpoints/v2_rung8a_lte_seed<seed>/ (seeds 777, 778, 779 trained)
#
# Inputs per node (12): vx, vy, vz / (10 km/s); log10 T, rho, P standardized by one global mean and std of the native
# training cube; the six log10 LTE (Saha-Boltzmann) Ca fractions from the atmosphere's own T and n_e (the raw n_e is not an
# input: n_e enters only through the Saha dependence). No magnetic field, no height coordinate.
# Targets: log10 of the six Ca level fractions (log_softmax head, fractions sum to one); loss = MSE on log10 f weighted by the
# Ca II relevance of each node, w = max(clip(f_CaII / relevance_threshold, 0, 1), coronal_weight).
# Training geometry: the cube stays at its 425 native levels; every sample draws a two-zone vertical grid in height above
# tau500 = 1 (60-110 km steps up to 3.8-4.8 Mm, 5-10 coronal levels, jitter, level removal; vertical_grids.py), hops of
# 1-max_stride pixels per axis and one rotation about z (the only augmentation). Edges: star topology over the columns within
# stencil_radius stencil units (49 of the 9x9 stencil), a node linked to a central node when their height difference is
# <= edge_reach_Mm (central_reach_Mm between two central nodes), so the receptive field in km is the same for every hop and grid.
# Validation every epoch on the held-out corner (32-px guard) at stride max_stride on the dense:60 grid (the deployment grid), in dex.
# Inference: gnn_inference.py / muram_comparison/muram_inference.py on the dense:60 grid with ~190 km hops (Bifrost stride 4,
# MURaM stride 8); ensemble.py averages the seeds.

[system]
gpu = 0
seed = 777
# fraction of the GPU memory the training may use (shared GPU); comment out for an exclusive GPU
gpu_memory_fraction = 0.65

[data]
datadir = '../data_train_v2'
grid_file = '../en024048_hion/grid_bifrost.npz'
nx = 504
ny = 504
# levels of the native cube (FITS indices 52-476)
nz_orig = 425
nlev = 6
# input quantities ('lte' is derived from temp and n_e)
features = 'vel', 'temp', 'rho', 'press', 'lte'

[dataset]
# validation grid = the deployment grid: 'dense[:km]' = km steps from the bottom native level to 4.5 Mm + 7 coronal levels;
# 'two_zone[:km]' is also accepted (vertical_grids.training_grid)
grid = 'dense:60'
# stencil: (2 x_range_graph + 1) x (2 y_range_graph + 1) columns, hops of 1..max_stride pixels; edges within the disc of
# radius stencil_radius (stencil units) and the vertical reaches in Mm
x_range_graph = 4
y_range_graph = 4
max_stride = 4
stencil_radius = 4.01
edge_reach_Mm = 0.5
central_reach_Mm = 2.0
# rotation of the volume by 0/90/180/270 deg about z, one draw per training sample ((vx, vy) rotated); nothing else
augment_rotation = True
# fraction of the domain (per axis) used for training; the rest is the held-out corner
train_ratio = 0.7

[training]
lr = 1e-3
batch_size = 8
# fraction of the training columns drawn (afresh) every epoch
epoch_size_fraction = 0.2
n_epochs = 15
savedir = 'checkpoints/v2_rung8a_lte'
# smoothing of the displayed training loss
smooth = 0.01
# held-out columns this far (px) from the training region are validated
valid_guard = 32
num_workers = 8
# AdamW with decoupled weight decay on the weight matrices, linear warmup (warmup_epochs) + cosine to zero stepped per batch,
# gradient clipping, EMA of the weights with the (1+n)/(10+n) ramp (validated next to the raw weights)
weight_decay = 0.01
adam_betas = 0.9, 0.95
adam_eps = 1e-6
warmup_epochs = 1
grad_clip = 1.0
ema_decay = 0.9998
# loss weights: nodes with a Ca II fraction below relevance_threshold are down-weighted linearly, never below coronal_weight
relevance_threshold = 1e-2
coronal_weight = 0.1

[model]
# 12 inputs: vx, vy, vz, log T, log rho, log P and the six log10 LTE Ca fractions
node_input_size = 12
# edge features: dz, horizontal distance, |dr| [Mm]
edge_input_size = 3
global_input_size = 1
latent_size = 128
mlp_hidden_size = 64
mlp_n_hidden_layers = 3
dropout=0.25
n_message_passing_steps = 8
# 6 outputs: the five Ca II levels and Ca III
output_size = 6
# outputs = log10(softmax + head_log_offset): fractions that sum exactly to one
head = 'log_softmax'
head_log_offset = 1e-12

[normalization]
# targets log10(f + log_offset)
log_offset = 1e-12
